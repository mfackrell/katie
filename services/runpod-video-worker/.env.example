# COPY THIS FILE TO .env LOCALLY. DO NOT COMMIT .env.
# Never put an active token in source code, a public repository, or a chat.
# This key is used by scripts/smoke_runpod.py to call an already deployed endpoint.
# It is NOT passed into the GPU worker container.
RUNPOD_API_KEY=REPLACE_WITH_YOUR_RUNPOD_API_KEY
# The endpoint ID will only exist after provisioning in RunPod.
RUNPOD_ENDPOINT_ID=REPLACE_WITH_YOUR_ENDPOINT_ID
