{
  "name": "katie-monorepo",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:runtime": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check:url": "node scripts/check-no-legacy-url.mjs",
    "db:migrate": "node scripts/run-migrations.mjs",
    "smoke": "node scripts/smoke-runtime.mjs",
    "ci:gate": "npm run typecheck && npm test && npm run check:url && npm run build && npm run smoke",
    "test:website": "node scripts/run-tests.mjs website",
    "postbuild": "node scripts/video-upload-production-smoke.mjs",
    "test:video-fallback": "node scripts/run-tests.mjs video-fallback",
    "test:review": "node scripts/run-tests.mjs review",
    "test:vitest": "node scripts/run-tests.mjs vitest"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/swagger": "^9.5.1",
    "@octokit/rest": "^20.0.2",
    "@supabase/supabase-js": "^2.50.0",
    "bullmq": "^5.58.0",
    "fastify": "^5.2.1",
    "@google/genai": "^1.28.0",
    "ioredis": "^5.7.0",
    "next": "15.1.11",
    "openai": "^4.85.4",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zod": "^3.23.8",
    "mammoth": "^1.6.0",
    "xlsx": "^0.18.5",
    "pdf2json": "^3.1.4",
    "emoji-picker-react": "4.22.2",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.1",
    "@sparticuz/chromium": "148.0.0",
    "playwright-core": "1.63.0",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.15.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
