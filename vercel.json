{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/chat/route.ts": {
      "maxDuration": 800
    }
  },
  "crons": [
    {
      "path": "/api/internal/runpod-results/reconcile",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/runpod-results/grok-fallback",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/video-handoffs/reconcile",
      "schedule": "* * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/visual-review-integration": false
    }
  }
}
