  "constraints": [
    {
      "name": "video_analysis_jobs_actor_id_fkey",
      "definition": "FOREIGN KEY (actor_id) REFERENCES actors(id) ON DELETE SET NULL"
    },
    {
      "name": "video_analysis_jobs_chat_id_fkey",
      "definition": "FOREIGN KEY (chat_id) REFERENCES chats(id) ON DELETE SET NULL"
    },
    {
      "name": "video_analysis_jobs_content_limit",
      "definition": "CHECK ((char_length(COALESCE(analysis_text, ''::text)) <= 250000))"
    },
    {
      "name": "video_analysis_jobs_id_limit",
      "definition": "CHECK ((char_length(COALESCE(runpod_job_id, ''::text)) <= 150))"
    },
    {
      "name": "video_analysis_jobs_no_signed_source",
      "definition": "CHECK (((attachment_path IS NULL) OR ((attachment_path !~~ '%?%'::text) AND (attachment_path !~~ '%://%'::text))))"
    },
    {
      "name": "video_analysis_jobs_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "video_analysis_jobs_runpod_job_id_key",
      "definition": "UNIQUE (runpod_job_id)"
    },
    {
      "name": "video_analysis_jobs_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['pending'::text, 'queued'::text, 'in_progress'::text, 'completed'::text, 'failed'::text, 'cancelled'::text, 'timed_out'::text, 'expired'::text])))"
    },
    {
      "name": "video_analysis_jobs_target_chat_id_fkey",
      "definition": "FOREIGN KEY (target_chat_id) REFERENCES chats(id) ON DELETE SET NULL"
    }
  ],
  "indexes": [
    {
      "indexname": "video_analysis_jobs_pkey",
      "indexdef": "CREATE UNIQUE INDEX video_analysis_jobs_pkey ON public.video_analysis_jobs USING btree (id)"
    },
    {
      "indexname": "video_analysis_jobs_runpod_job_id_key",
      "indexdef": "CREATE UNIQUE INDEX video_analysis_jobs_runpod_job_id_key ON public.video_analysis_jobs USING btree (runpod_job_id)"
    },
    {
      "indexname": "video_analysis_jobs_active_idx",
      "indexdef": "CREATE INDEX video_analysis_jobs_active_idx ON public.video_analysis_jobs USING btree (submitted_at) WHERE (status = ANY (ARRAY['pending'::text, 'queued'::text, 'in_progress'::text]))"
    },
    {
      "indexname": "video_analysis_jobs_chat_idx",
      "indexdef": "CREATE INDEX video_analysis_jobs_chat_idx ON public.video_analysis_jobs USING btree (chat_id, submitted_at DESC)"
    },
    {
      "indexname": "video_analysis_jobs_chat_delivery_idx",
      "indexdef": "CREATE INDEX video_analysis_jobs_chat_delivery_idx ON public.video_analysis_jobs USING btree (chat_request_id, video_index) WHERE (chat_request_id IS NOT NULL)"
    },
    {
      "indexname": "video_analysis_jobs_pending_fallback_idx",
      "indexdef": "CREATE INDEX video_analysis_jobs_pending_fallback_idx ON public.video_analysis_jobs USING btree (submitted_at) WHERE (fallback_state = 'pending'::text)"
    }
  ],
  "security": {
    "rls": [
      {
        "rls_enabled": true
      }
    ],
